{
  "name": "angular-graph",
  "version": "1.0.0",
  "type": "module",
  "env-file": "../../.env",
  "scripts": {
    "ng": "ng",
    "prebuild": "node scripts/build-env.js",
    "prestart": "node scripts/build-env.js",
    "prewatch": "node scripts/build-env.js",
    "start": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "test:auth-callback": "node --experimental-strip-types --test scripts/auth-callback.test.mjs",
    "test:graph-message-path": "node --experimental-strip-types --test scripts/graph-message-path.test.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@azure/communication-calling": "^1.43.1",
    "@azure/communication-common": "^2.5.0",
    "@azure/msal-browser": "^5.17.3",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
